            reqShieldData__120.value := v_262_at122
            // runInBackground(key, lockType, token) { ... } @125 (inlined, 137-158)
            var e_145_at125: Int
            var dropped_145_at125: Bool
            e_145_at125, dropped_145_at125 := CompletableFuture_runAsync()   // @144-146
            if (e_145_at125 == NONE) {
              tr.nspawn := tr.nspawn + 1
              if (!dropped_145_at125) {
                exhale TASK125_PRE(k, mode, PHASE(tr), lockType__85, token__89)   // spawn task_125
              }
            } elseif (e_145_at125 == REE) {
              // catch (e: RejectedExecutionException) @147
              if (token__89 != NULL) {                         // @149
                var e_152_at125: Int
                var u_152_at125: Bool
                e_152_at125, u_152_at125 := KeyLock_unLock(k, lockType__85, token__89)   // @152
                if (e_152_at125 != NONE && !IS_EXCEPTION(e_152_at125)) {
                  exc := e_152_at125
