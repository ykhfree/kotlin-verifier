            }
          }
        } else {
          // handleLockFailure(key, callable, timeToLiveMillis) @109 (inlined, 173-198)
          var attempts__178: Int := 0
          var consecutiveFailures__179: Int := 0
          var found_187: Ref := null    // `return cachedData` @187 is pending
          var break_192: Bool := false  // `break` @192
          while (exc == NONE && found_187 == null && !break_192 && attempts__178 < maxAttempt)   // @181
            // tool frame: the loop reads tr.first and writes the poll fields; it holds no obligation (LD_wait)
            invariant acc(tr.first, 1/2) && tr.first == MISS
            invariant acc(tr.npoll) && acc(tr.consec) && acc(tr.pollHit) && acc(tr.pollObj)
            invariant NO_LEASES                                 // LD_wait
            invariant exc == NONE || exc == CE_GET || (MAY_ERR && exc == ERR)
            // hole (loop invariant): the code's counters against the trace
            invariant 0 <= attempts__178 && (maxAttempt < 0 ? attempts__178 == 0 : attempts__178 <= maxAttempt)
            invariant tr.npoll <= attempts__178 && (exc == NONE ==> tr.npoll == attempts__178)
            invariant exc == NONE && found_187 == null ==> tr.consec == consecutiveFailures__179
            invariant (break_192 ==> consecutiveFailures__179 >= MAX_FAIL) && (!break_192 ==> consecutiveFailures__179 < MAX_FAIL)
            invariant (found_187 != null) == tr.pollHit && (found_187 != null ==> tr.pollObj == found_187 && exc == NONE)
            decreases maxAttempt - attempts__178
          {
            attempts__178 := attempts__178 + 1                 // @182
            // sleepBetweenPolls(key) @183 (inlined, 200-208)
            var e_202_at183: Int
            e_202_at183 := Thread_sleep()
            if (e_202_at183 == INTR) {
              exc := CE_GET                                    // interrupt restored, GET_CACHE_ERROR @203-206
            } elseif (e_202_at183 != NONE) {
              exc := e_202_at183
            }
            if (exc == NONE) {
              // try @185
              var e_186: Int
              var cachedData__186: Ref
