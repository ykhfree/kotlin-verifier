// Skeleton of the KeyLocalLock specification. Format: kv-sidecar/0.
// The binding part below (types, state, class, use, trusted fun, ghost record, witness, the free/result lines of
// each operation) is fixed: the team's tooling derives it from the shape every implementation must follow.
// Do not change, remove or reorder the fixed lines. Add your clauses only where a line says "DRAFT".

// ---- Abstract types for String values ----
type Key   = opaque                     // lock keys: one per (cache key, lock type)
type Token = template "local-${Long}"   // a token "local-" + n is the number n >= 0; null is NULL

// ---- Module state (one map shared by the whole JVM) ----
state m:   Map<Key, LockInfo> = lockMap

// ---- Classes reachable from the state ----
class LockInfo = KeyLocalLock.LockInfo {
  permits:   Semaphore     = semaphore   // free permits of the entry's semaphore (an Int)
  isHeld:    AtomicBoolean = isHeld      // the entry's held flag (a Bool)
  token:     Token?        = token       // the token the entry carries, or NULL
  expiresAt: Long          = expiresAt   // the entry's expiry time in epoch milliseconds (an Int)
}

// ---- Trusted models (built into the tool) ----
use jdk.ConcurrentHashMap.compute
use jdk.ConcurrentHashMap.mappingCount
use jdk.ConcurrentHashMap.racyRead
use jdk.Semaphore
use jdk.AtomicBoolean
use jdk.AtomicLong
use jdk.AtomicCell
use jdk.System.currentTimeMillis
use slf4j.Logger

// ---- Trusted project functions (bodies read by a person) ----
trusted fun com.linecorp.cse.reqshield.support.utils.nowToEpochTime() = clock
  reviewed "ykhfree 2026-10-23: support/.../utils/TimeUtils.kt:23: fun nowToEpochTime() = System.currentTimeMillis()" sha256 "aa569e5b9740b13b"
trusted fun com.linecorp.cse.reqshield.support.config.LocalLockLimit.rejectsNewEntry(kotlin.Long)
  returns rej: Bool
  ghost   limit: Int                    // the cap the call read
  ensures rej ==> limit != 0
  effects none                          // rejectionCount and logging are outside the model
  reviewed "ykhfree 2026-10-23: support/.../config/LocalLockLimit.kt:86-101: returns false when limit == UNLIMITED_LOCK_ENTRIES (0L) or currentSize < limit" sha256 "c5bffa07e14e90b1"

// ---- Ghost state: one record per token value ----
ghost record tok(Token) {
  gIssued: Bool set-once                // tryLock returned this token (the tool sets it)
  gKey:    Key  frozen                  // the key the token was issued for (the issue rule sets it)
  gBacked: Bool frozen                  // a map entry carried the token when it was issued (the issue rule sets it)
  gHeld:   Bool ends                    // the acquisition has not ended (the tool sets and ends it)
  gLease:  Int  frozen                  // the time the acquisition expires (the issue rule sets it)
}
witness LockInfo.token                  // a backed token is held while its key's entry carries it

// ---- Operations: exactly one atomic action each ----
operation tryLock = fun KeyLocalLock.tryLock {
  free now        = local now           // the clock reading tryLock takes before its atomic step
  free timeout    = this.lockTimeoutMillis
  free rej, limit = call rejectsNewEntry
  result res
  // DRAFT: the issue rule, ensures clauses and allowance clauses of tryLock

  issue res { gKey = k; gBacked = carried(S, k, res); gLease = now + timeout }
    source "KeyLock.kt(core)#tryLock" quote "Acquires the lock for [key] + [lockType]." sha256 "68befb2c296b8dfa"
    source "README.md#local-lock-map-size/2" quote "once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"
    source "README.md#local-lock-map-size/4" quote "Once the map is full, a request for a **new** key is handed a permit that no map entry backs." sha256 "22ecf436faddbfa1"

  ensures tryLock_held_key_returns_null: old(has(S, k)) ==> res == NULL
    source "KeyLock.kt(core)#tryLock" quote "@return an opaque ownership token, or null when another holder owns the lock." sha256 "68befb2c296b8dfa"
    source "README.md#local-lock-map-size/4" quote "are not subject to the cap at all." sha256 "22ecf436faddbfa1"
    source "CLAUDE.md#project-overview/1" quote "ensuring only one request for the same cache key is processed at a time" sha256 "4c399b7f21c48357"

  ensures tryLock_held_key_unchanged: old(has(S, k)) ==>
    has(S, k) && S.m[k].token == old(S.m[k].token) && S.m[k].expiresAt == old(S.m[k].expiresAt)
    source "KeyLock.kt(core)#tryLock" quote "@return an opaque ownership token, or null when another holder owns the lock." sha256 "68befb2c296b8dfa"
    source "KeyLock.kt(core)#KeyLock" quote "Ownership is represented by an opaque token" sha256 "029ff8a4f97809d0"

  ensures progress_tryLock_free_key_acquires: !old(has(S, k)) && !rej ==>
    res != NULL && carried(S, k, res)
    source "KeyLock.kt(core)#tryLock" quote "Acquires the lock for [key] + [lockType]." sha256 "68befb2c296b8dfa"
    source "README.md#local-lock-map-size/3" quote "The map is uncapped by default." sha256 "c9f558f7102a8834"
    source "README.md#local-lock-map-size/1" quote "keeps one entry per `(cache key, lock type)` it is currently" sha256 "4b545b75bf0b21e0"

  ensures tryLock_sets_lease: res != NULL && has(S, k) && carried(S, k, res) ==>
    S.m[k].expiresAt == now + timeout
    source "README.md#local-lock-map-size/2" quote "once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"
    source "CLAUDE.md#reqshieldconfiguration-parameters/4" quote "`lockTimeoutMillis`: Lock acquisition timeout (default: 3000ms)" sha256 "96bb2ac381ef4f65"

  ensures progress_tryLock_cap_refusal_proceeds: !old(has(S, k)) && rej ==>
    res != NULL && !has(S, k)
    source "README.md#local-lock-map-size/4" quote "Once the map is full, a request for a **new** key is handed a permit that no map entry backs." sha256 "22ecf436faddbfa1"
    source "README.md#local-lock-map-size/4" quote "no added latency, and the cache still gets populated" sha256 "22ecf436faddbfa1"

  unbacked_only_if tryLock_unbacked_only_on_cap_refusal: rej
    source "README.md#local-lock-map-size/4" quote "Once the map is full, a request for a **new** key is handed a permit that no map entry backs." sha256 "22ecf436faddbfa1"
}

operation unLock = fun KeyLocalLock.unLock {
  free t: Token = param token
  result res
  // DRAFT: ensures clauses and allowance clauses of unLock

  ensures unLock_true_only_for_owner: res ==> old(carried(S, k, t))
    source "KeyLock.kt(core)#unLock" quote "Releases the lock for [key] + [lockType] only if [token] matches the current owner." sha256 "5066248acc117759"
    source "KeyLock.kt(core)#unLock" quote "@return false when the lock is not held or the token does not match the current owner." sha256 "5066248acc117759"
    source "CLAUDE.md#key-components/2" quote "`unLock` only releases when the token matches" sha256 "58d3866dfcb69dcf"

  ensures progress_unLock_owner_releases: old(carried(S, k, t)) ==> res && !has(S, k)
    source "README.md#local-lock-map-size/2" quote "An entry is dropped as soon as the lock is released" sha256 "a50a09d95953837f"
    source "KeyLock.kt(core)#unLock" quote "Releases the lock for [key] + [lockType] only if [token] matches the current owner." sha256 "5066248acc117759"

  ensures unLock_failure_changes_nothing: !res ==>
    (old(has(S, k)) == has(S, k)) &&
    (old(has(S, k)) ==> (S.m[k].token == old(S.m[k].token) && S.m[k].expiresAt == old(S.m[k].expiresAt)))
    source "KeyLock.kt(core)#KeyLock" quote "cannot release the new owner's lock." sha256 "029ff8a4f97809d0"
    source "CLAUDE.md#key-components/2" quote "so a slow holder cannot release someone else's lock" sha256 "58d3866dfcb69dcf"

  ends_only_if unLock_ends_only_presented_token: qt == t && res
    source "KeyLock.kt(core)#KeyLock" quote "only the holder that acquired the lock can" sha256 "029ff8a4f97809d0"
    source "CLAUDE.md#key-components/2" quote "`unLock` only releases when the token matches" sha256 "58d3866dfcb69dcf"
}

operation sweep = compute in KeyLocalLock.Companion {
  free now = local now                  // the clock reading of one monitor pass
  // DRAFT: ensures clauses and allowance clauses of sweep (one monitor step on one key)

  ensures sweep_never_adds_or_changes: has(S, k) ==>
    old(has(S, k)) && S.m[k].token == old(S.m[k].token) && S.m[k].expiresAt == old(S.m[k].expiresAt)
    source "README.md#local-lock-map-size/2" quote "an entry whose holder never released it" sha256 "a50a09d95953837f"
    source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"

  ensures progress_sweep_drops_expired: old(has(S, k)) && old(S.m[k].expiresAt) <= now ==> !has(S, k)
    source "README.md#local-lock-map-size/2" quote "an entry whose holder never released it" sha256 "a50a09d95953837f"
    source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"

  ensures sweep_keeps_unexpired: old(has(S, k)) && now < old(S.m[k].expiresAt) ==> has(S, k)
    source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"

  ends_only_if sweep_ends_only_expired: tok(qt).gLease <= now
