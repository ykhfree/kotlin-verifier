// DRAFT: one probe (a scenario from the empty module)

probe(k1: Key, a: Int, d: Int) requires d > 0 {
  t1 := tryLock(k1, now = a, timeout = d, rej = false, limit = 0)
  assert t1 != NULL && carried(S, k1, t1) && S.m[k1].expiresAt == a + d
  t2 := tryLock(k1, now = a + d - 1, timeout = d, rej = true, limit = 1)
  assert t2 == NULL && carried(S, k1, t1)
  t3 := tryLock(k1, now = a + d, timeout = d, rej = true, limit = 1)
  assert t3 != NULL && t3 != t1 && carried(S, k1, t3)
  u1 := unLock(k1, t = t1)
  assert !u1 && carried(S, k1, t3)
  u3 := unLock(k1, t = t3)
  assert u3 && !has(S, k1)
  t4 := tryLock(k1, now = a + d, timeout = d, rej = true, limit = 1)
  assert t4 != NULL && !has(S, k1)
  u4 := unLock(k1, t = t4)
  assert !u4 && !has(S, k1)
}
  source none "probe: a scenario from the empty module that shows the clauses are not vacuous"
