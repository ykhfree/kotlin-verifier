  free now = local now                  // the clock reading of one monitor pass
  // DRAFT: ensures clauses and allowance clauses of sweep (one monitor step on one key)

  ensures progress_sweep_drops_expired: old(has(S, k)) && now >= old(S.m[k].expiresAt) ==> !has(S, k)
    source "README.md#local-lock-map-size/2" quote "an entry whose holder never released it is dropped by the" sha256 "a50a09d95953837f"
    source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"

  ensures sweep_keeps_live_entry: old(has(S, k)) && now < old(S.m[k].expiresAt) ==>
      has(S, k) && S.m[k].token == old(S.m[k].token) && S.m[k].expiresAt == old(S.m[k].expiresAt)
    source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"
    source "README.md#global-lock-guidance/2" quote "Only the holder that acquired the lock can release it" sha256 "ffd91c43c843b5f8"

  ensures sweep_adds_no_entry: !old(has(S, k)) ==> !has(S, k)
    source "README.md#local-lock-map-size/1" quote "keeps one entry per `(cache key, lock type)` it is currently" sha256 "4b545b75bf0b21e0"

  ends_only_if sweep_ends_only_expired: now >= tok(qt).gLease
    source "README.md#local-lock-map-size/2" quote "an entry whose holder never released it is dropped by the" sha256 "a50a09d95953837f"
    source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"
}

// DRAFT: invariants and lemmas

invariant inv_held_backed_token_carried_with_lease:
  forall x: Int :: { tok(x).gHeld }
    tok(x).gIssued && tok(x).gBacked && tok(x).gHeld ==>
      carried(S, tok(x).gKey, x) && S.m[tok(x).gKey].expiresAt == tok(x).gLease
  source "README.md#local-lock-map-size/1" quote "keeps one entry per `(cache key, lock type)` it is currently" sha256 "4b545b75bf0b21e0"
  source "README.md#local-lock-map-size/2" quote "cleanup monitor once `lockTimeoutMillis` has passed" sha256 "a50a09d95953837f"

invariant inv_unbacked_token_never_carried:
  forall x: Int :: { tok(x).gBacked }
    tok(x).gIssued && !tok(x).gBacked ==> !carried(S, tok(x).gKey, x)
  source "README.md#local-lock-map-size/4" quote "Once the map is full, a request for a **new** key is handed a permit that no map entry backs." sha256 "22ecf436faddbfa1"

lemma lemma_one_backed_holder_per_key:
  forall x: Int :: { tok(x).gHeld }
    forall y: Int :: { tok(y).gHeld }
      tok(x).gIssued && tok(x).gBacked && tok(x).gHeld &&
      tok(y).gIssued && tok(y).gBacked && tok(y).gHeld &&
      tok(x).gKey == tok(y).gKey ==> x == y
  source "CLAUDE.md#project-overview/1" quote "ensuring only one request for the same cache key is processed at a time" sha256 "4c399b7f21c48357"
  source "KeyLock.kt(core)#KeyLock" quote "Lock used to collapse concurrent requests for the same cache key." sha256 "029ff8a4f97809d0"

