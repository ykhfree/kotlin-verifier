// Scenario cells generated by `kv spec cells` from keylocallock.coroutine.kv (DESIGN-C.md 3.2, C4). Generate them again; do not edit.
// Vocabulary the rule read from the sidecar:
//   state map m: Map<Key, LockInfo>; object module (ghost record tok(Token), backed field gBacked)
//   issuing operation: tryLock (set-up: tryLock(k, now = 0, timeout = 10, rej = false, limit = 0))
//   lease: gLease = now + timeout, 10 at the set-up; times 5, 10, 11 (before, at, after)
//   operation tryLock(now clock, timeout instance value 10, rej {false, true}, limit {0, 5}) -> issued value; trusted contracts: rej ==> limit != 0
//   operation unLock(t token) -> Bool
//   operation sweep(now clock) -> no result
// Prefixes: E the empty module; H the set-up; K the set-up, then a step on another key k2; O the set-up, then a step after which k's entry no longer holds t1; U a token no entry backs.
// IDs end in r (the result) or s (k's entry). A cell marked boundary has a clock reading equal to the lease
// (DESIGN-C.md 3.3 rule 5).

cell E1r(k: Key) "Empty module. tryLock(k, now = 0, timeout = 10, rej = false, limit = 0): the result" {
  r := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0)
  outcome null: r == NULL
  outcome backed: r != NULL && tok(r).gBacked
  outcome unbacked: r != NULL && !tok(r).gBacked
}

cell E1s(k: Key) "Empty module. tryLock(k, now = 0, timeout = 10, rej = false, limit = 0): k's entry" {
  r := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0)
  outcome no_entry: !has(S, k)
  outcome holds_r: r != NULL && carried(S, k, r)
  outcome other: has(S, k) && !(r != NULL && carried(S, k, r))
}

cell E2r(k: Key) "Empty module. tryLock(k, now = 0, timeout = 10, rej = false, limit = 5): the result" {
  r := tryLock(k, now = 0, timeout = 10, rej = false, limit = 5)
  outcome null: r == NULL
  outcome backed: r != NULL && tok(r).gBacked
  outcome unbacked: r != NULL && !tok(r).gBacked
}

cell E2s(k: Key) "Empty module. tryLock(k, now = 0, timeout = 10, rej = false, limit = 5): k's entry" {
