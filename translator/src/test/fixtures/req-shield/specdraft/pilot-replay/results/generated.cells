}

cell E3r(k: Key) "Empty module. tryLock(k, now = 0, timeout = 10, rej = true, limit = 5): the result" {
  r := tryLock(k, now = 0, timeout = 10, rej = true, limit = 5)
  outcome null: r == NULL
  outcome backed: r != NULL && tok(r).gBacked
  outcome unbacked: r != NULL && !tok(r).gBacked
}

cell E3s(k: Key) "Empty module. tryLock(k, now = 0, timeout = 10, rej = true, limit = 5): k's entry" {
  r := tryLock(k, now = 0, timeout = 10, rej = true, limit = 5)
