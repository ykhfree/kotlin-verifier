cell K1r(k: Key, k2: Key) "Set-up: t1 := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0) returned a token k's entry backs (lease 10); k2 is another key. tryLock(k2, now = 5, timeout = 10, rej = false, limit = 0) (before the lease): the result" {
  t1 := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0)
  assume t1 != NULL && tok(t1).gBacked
  assume k2 != k
  r := tryLock(k2, now = 5, timeout = 10, rej = false, limit = 0)
  outcome null: r == NULL
  outcome backed: r != NULL && tok(r).gBacked
  outcome unbacked: r != NULL && !tok(r).gBacked
}

