  r := tryLock(k, now = 5, timeout = 10, rej = false, limit = 0)
  outcome no_entry: !has(S, k)
  outcome holds_t1: carried(S, k, t1)
  outcome holds_r: r != NULL && r != t1 && carried(S, k, r)
  outcome other: has(S, k) && !carried(S, k, t1) && !(r != NULL && r != t1 && carried(S, k, r))
}

