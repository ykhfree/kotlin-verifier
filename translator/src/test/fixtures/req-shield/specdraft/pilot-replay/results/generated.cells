  outcome holds_r: r != NULL && carried(S, k, r)
  outcome other: has(S, k) && !(r != NULL && carried(S, k, r))
}

cell E4r(k: Key, x: Token) "Empty module. unLock(k, t = x) with x, a token never issued: the result" {
  assume x >= 0 && !tok(x).gIssued
  r := unLock(k, t = x)
  outcome true: r
  outcome false: !r
}

cell E4s(k: Key, x: Token) "Empty module. unLock(k, t = x) with x, a token never issued: k's entry" {
  assume x >= 0 && !tok(x).gIssued
  r := unLock(k, t = x)
  outcome no_entry: !has(S, k)
  outcome other: has(S, k)
}

cell E5s(k: Key) "Empty module. sweep(k, now = 0): k's entry" {
  sweep(k, now = 0)
  outcome no_entry: !has(S, k)
  outcome other: has(S, k)
}

cell H1r(k: Key) "Set-up: t1 := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0) returned a token k's entry backs (lease 10). tryLock(k, now = 5, timeout = 10, rej = false, limit = 0) (before the lease): the result" {
  t1 := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0)
  assume t1 != NULL && tok(t1).gBacked
  r := tryLock(k, now = 5, timeout = 10, rej = false, limit = 0)
  outcome null: r == NULL
  outcome backed: r != NULL && tok(r).gBacked
  outcome unbacked: r != NULL && !tok(r).gBacked
}

cell H1s(k: Key) "Set-up: t1 := tryLock(k, now = 0, timeout = 10, rej = false, limit = 0) returned a token k's entry backs (lease 10). tryLock(k, now = 5, timeout = 10, rej = false, limit = 0) (before the lease): k's entry" {
