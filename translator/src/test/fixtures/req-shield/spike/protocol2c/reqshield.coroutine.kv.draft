// ---- Hole (layer 5): the polling loop; the order differs from core (read, attempts++, delay) ----
// The six conjuncts of e5/target-coroutine.vpr (the sixth is new: the loop keeps a raised cancellation).
hole loop ReqShield.handleLockFailure """
  0 <= attempts && (maxAttempt < 0 ? attempts == 0 : attempts <= maxAttempt) &&
  npoll <= (maxAttempt < 0 ? 0 : maxAttempt) && (exc == NONE && !returned && !broke ==> npoll == attempts) &&
  (exc == NONE && !returned ==> consec == consecutiveFailures) &&
  (broke ==> consecutiveFailures >= 3) && (!broke ==> consecutiveFailures < 3) &&
  returned == poll.hit && (returned ==> poll.obj == result && exc == NONE) &&
  (cancelled ==> exc == CANCEL)
"""
