    reviewed "PROPOSED (same as core): the wait polls the cache at most maxAttemptGetCache times" sha256 "0000000000000000"
  // UE7 (proposed (a)): a RET clause does not apply to a call that ends with a cancellation.
  ensures RET_hit: first == HIT && exc != CANCEL ==> exc == NONE && res == first.obj
