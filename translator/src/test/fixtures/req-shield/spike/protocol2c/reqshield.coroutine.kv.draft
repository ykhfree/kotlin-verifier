// DRAFT (DESIGN-E5 5): sidecar for req-shield core-kotlin-coroutine ReqShield, the L3 client protocol under cancellation.
// Not signed. Every `reviewed` line below is a PROPOSED note; sha256 "0000000000000000" marks a fingerprint the tool
// computes in the signing round (kv resolve reports stale-review with the value; DESIGN-E 12.6 steps 6-8).
// Quoted sources are blocks of `kv spec snapshot` (specdraft/reqshield-coroutine/snapshot, new) over README.md,
// CLAUDE.md and the KDoc of the coroutine ReqShield.kt, ReqShieldConfiguration.kt, KeyLock.kt and support
// ClientException.kt. README/CLAUDE blocks and ClientException.kt#ClientException have the core snapshot's values.
// A `//` comment or a test of the coroutine module is no snapshot block: such a source is a `source none` line.
review intent

module com.linecorp.cse.reqshield.kotlin.coroutine.ReqShield client
source "core-kotlin-coroutine/src/main/kotlin"

// The core's scope note has sha256 "9dee5e78c92be221"; whether the unit is only the README section is not checked here.
scope "README.md#waiting-for-another-request-lock-not-acquired"
  reviewed "PROPOSED: this sidecar answers for every block of the README section on a request that waits for another request's lock" sha256 "0000000000000000"

// ---- Types ----
type Key   = opaque                                       // the cache key the call gets
type Token = opaque                                       // a lock's ownership token
enum LockType = LockType                                  // CREATE, UPDATE (the coroutine package's LockType)
enum Mode = ReqShieldWorkMode                             // the coroutine config package's ReqShieldWorkMode
class Data = ReqShieldData { value: Int = value }         // the cached object; `value` is the supplier's value

// ---- Vocabulary (layer 3) ----
obligation Lease(Key, LockType, Token)

// As reqshield.core.kv, with the supplier `callable` (a suspend function parameter), the spawn `kotlinx.launch`, and one
// new event form: `raised KIND` is true once a call of the entry raised that kind (DESIGN-E5 2.8; tasks do not record it).
trace {
  first   = first getCacheFunction
  recheck = getCacheFunction while holds(Lease(k, CREATE, _))
  poll    = hit getCacheFunction where !first && !holds(Lease(k, CREATE, _))
  npoll   = count getCacheFunction where !first && !holds(Lease(k, CREATE, _))
  consec  = trailing failures of npoll
  sup     = last callable
  nsup    = count callable
  ntryC   = count KeyLock.tryLock where lt == CREATE
  ntryU   = count KeyLock.tryLock where lt == UPDATE
  nspawn  = count kotlinx.launch                                            // blocks the dispatcher accepted
  cancelled = raised CANCEL                                                 // E5: some call raised a cancellation
  derived PHASE   = first == HIT ? UPDATE : CREATE
  derived GAVE_UP = npoll >= maxAttempt || consec >= 3
}

review vocabulary
  reviewed "PROPOSED: the vocabulary of the lock-discipline protocol for the coroutine variant: types, enums, the Data binding, obligation Lease, the trace rules with PHASE and GAVE_UP, and the cancellation record `cancelled` (DESIGN-E 3.1, 3.2; DESIGN-E5 2.8)" sha256 "0000000000000000"

// ---- Trust (layer 2) ----
// CANCEL in `throws`: the call is a suspension point; it raises a CancellationException only when it runs in a
// cancellable context (not inside withContext(NonCancellable)). The tool checks CANCEL against the FIR: a suspend
// function or a suspend function type must list it, any other must not (DESIGN-E5 6, step S3).
trusted fun KeyLock.tryLock(k: Key, lt: LockType) returns t: Token? creates Lease(k, lt, t) if t != null throws RTE, CANCEL
  reviewed "PROPOSED: coroutine KeyLock.kt contract: a non-null token is one acquisition that the caller must release; the suspend call may throw a RuntimeException, or a CancellationException when the caller is cancelled" sha256 "0000000000000000"
trusted fun KeyLock.unLock(k: Key, lt: LockType, t: Token) returns released: Bool consumes Lease(k, lt, t) throws RTE, CANCEL
  reviewed "PROPOSED: coroutine KeyLock.kt contract: unLock ends the acquisition of its token; it may throw a RuntimeException; a cancelled unLock (outside NonCancellable) may not have released" sha256 "0000000000000000"
trusted value ReqShieldConfiguration.getCacheFunction(k: Key) returns d: Data? throws RTE, CHK, CANCEL
  reviewed "PROPOSED: a suspend user function: returns the cached data or null, and may throw" sha256 "0000000000000000"
trusted value ReqShieldConfiguration.setCacheFunction(k: Key, d: Data, kotlin.Long) returns b: Bool throws RTE, CHK, CANCEL
  reviewed "PROPOSED: a suspend user function: writes the cache, and may throw" sha256 "0000000000000000"
trusted param ReqShield.getAndSetReqShieldData.callable() returns v: Int throws RTE, CHK, INTR, CANCEL
  reviewed "PROPOSED: the caller's suspend supplier: returns a value, or throws a RuntimeException, a checked exception, an interrupt, or a CancellationException" sha256 "0000000000000000"

use kotlinx.launch
use kotlinx.withContext
use kotlinx.ensureActive
use kotlinx.delay
use slf4j.Logger

trusted fun com.linecorp.cse.reqshield.support.utils.decideToUpdateCache(kotlin.Long, kotlin.Long, kotlin.Int) returns b: Bool
  reviewed "ykhfree 2026-10-27: CommonUtils.kt:19-28 reads the clock and returns passedDuration >= ttl * pct / 100; it has no lock or cache effect, and the model leaves the result free" sha256 "a858dc2f51d5892c"

// ---- Assumptions (DESIGN-E 4, DESIGN-E5 2.4); A2 is off (UE3) ----
assume A1: errors-are-fatal
  source none "user decision UE2 (2026-10-26): a java.lang.Error ends the process, so no call throws one"
  reviewed "PROPOSED: assumed, not proven: a java.lang.Error ends the process (in the coroutine variant this also covers a supplier Error, which catch (e: Exception) does not release: Phase 0 A_F4)" sha256 "0000000000000000"
assume A3: accepted-tasks-run
