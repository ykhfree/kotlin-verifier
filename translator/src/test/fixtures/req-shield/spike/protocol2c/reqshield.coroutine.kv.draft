  source none "user decision UE4 (2026-10-26): a task the executor accepted runs; for a coroutine: a block the dispatcher accepted runs"
  reviewed "PROPOSED: assumed, not proven: a launched block that the dispatcher accepted runs (no executor shutdownNow drops it)" sha256 "0000000000000000"
assume A4: throwing-release-ends-obligation
  source none "user decision UE3 with A4 (2026-10-27), core ReqShield.kt:150, a code comment: A failed release must not cost the caller its data; the lock then expires on its own"
  reviewed "PROPOSED: assumed, not proven: an unLock that throws a RuntimeException ends the obligation, and the lock expires by its lease; a cancelled unLock is not covered" sha256 "0000000000000000"
assume A5: throwing-acquire-takes-nothing
  source none "user decision UE3 with A5 (2026-10-27), core ReqShieldConfiguration.kt KDoc: must let the lock expire"
  reviewed "PROPOSED: assumed, not proven: a tryLock that throws (a failure or a cancellation) leaves the caller no obligation, and the lock expires by its lease" sha256 "0000000000000000"
assume A6: dispatch-does-not-throw
  source none "user decision UE6 (2026-10-29): the coroutine dispatcher's dispatch does not throw, so scope.launch(start = CoroutineStart.ATOMIC) does not throw and its block runs"
  source "README.md#thread-pools-and-schedulers/3" quote "default: a shared supervisor scope on" sha256 "41a428d404dc17fc"
  reviewed "PROPOSED: assumed, not proven: scope.launch(start = ATOMIC) does not throw (kotlinx 1.8.1 has no catch around dispatch; Dispatchers.IO throws only after a shutdown)" sha256 "0000000000000000"

// ---- The public function: one coroutine's run ----
operation getAndSet = fun ReqShield.getAndSetReqShieldData {
  free mode = this.reqShieldConfig.reqShieldWorkMode
  free maxAttempt = this.reqShieldConfig.maxAttemptGetCache
  result res
  guard LD_write: setCacheFunction requires
      (PHASE == CREATE && mode != ONLY_UPDATE_CACHE ==> holds(Lease(k, CREATE, _))) &&
      (PHASE == UPDATE && mode != ONLY_CREATE_CACHE ==> holds(Lease(k, UPDATE, _)))
    source "CLAUDE.md#work-modes/2" quote "refreshes of existing entries still happen but without a lock" sha256 "d5348c7ce8fa2571"
    source "CLAUDE.md#work-modes/3" quote "on a cache miss every request calls the supplier and writes the cache without a lock" sha256 "b74493bbb6f1dcf8"
    source none "user decision UE5 (2026-10-27): the fallback after the wait does not write the cache"
    reviewed "PROPOSED (same as core): a cache write on a collapsing path holds that path's lock; the fallback after the wait writes no cache (UE5)" sha256 "0000000000000000"
  guard LD_supplier: callable requires
      (PHASE == CREATE && mode != ONLY_UPDATE_CACHE ==> holds(Lease(k, CREATE, _)) || GAVE_UP) &&
      (PHASE == UPDATE && mode != ONLY_CREATE_CACHE ==> holds(Lease(k, UPDATE, _)))
    source "ReqShield.kt#handleLockFailure" quote "end the wait early, after which the supplier is called on this coroutine as the last resort." sha256 "86fa18223492c680"
    source "CLAUDE.md#project-overview/1" quote "ensuring only one request for the same cache key is processed at a time" sha256 "4c399b7f21c48357"
    source "README.md#waiting-for-another-request-lock-not-acquired/2" quote "Three consecutive failures are treated as a cache outage and the request falls back to calling the supplier itself right away." sha256 "4a446045254ea7eb"
    reviewed "PROPOSED (same as core): a supplier call on a collapsing path holds that path's lock, except the creation fallback after the wait gave up" sha256 "0000000000000000"
  ensures MODE_create: mode == ONLY_UPDATE_CACHE ==> ntryC == 0
    source "CLAUDE.md#work-modes/3" quote "on a cache miss every request calls the supplier and writes the cache without a lock" sha256 "b74493bbb6f1dcf8"
    source none "ReqShield.kt:97 (coroutine), a code comment: ONLY_UPDATE_CACHE collapses requests on update only, so the creation runs without a lock."
    reviewed "PROPOSED (same as core): ONLY_UPDATE_CACHE never tries the CREATE lock" sha256 "0000000000000000"
  ensures MODE_update: mode == ONLY_CREATE_CACHE ==> ntryU == 0
    source "CLAUDE.md#work-modes/2" quote "refreshes of existing entries still happen but without a lock" sha256 "d5348c7ce8fa2571"
    source none "ReqShield.kt:69 (coroutine), a code comment: ONLY_CREATE_CACHE collapses requests on creation only, so the update runs without a lock."
    reviewed "PROPOSED (same as core): ONLY_CREATE_CACHE never tries the UPDATE lock" sha256 "0000000000000000"
  ensures SUP_once: nsup <= 1
    source "ReqShield.kt#handleLockFailure" quote "end the wait early, after which the supplier is called on this coroutine as the last resort." sha256 "86fa18223492c680"
    source "README.md#waiting-for-another-request-lock-not-acquired/3" quote "When the attempts are exhausted the request calls the supplier once." sha256 "0b4eefa677614205"
    reviewed "PROPOSED (same as core): one request calls the supplier at most once on the calling coroutine" sha256 "0000000000000000"
  ensures POLL_bound: npoll <= (maxAttempt < 0 ? 0 : maxAttempt)
