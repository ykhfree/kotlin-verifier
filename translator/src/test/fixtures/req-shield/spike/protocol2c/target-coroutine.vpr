// DESIGN-E5 hand model: req-shield ReqShield (core-kotlin-coroutine), lock discipline under cancellation.
// Hand-written "expected emitter output" of the E5 lowering, in the layout of the tool's core output (kv emit of
// specs/reqshield/reqshield.core.kv), not tool output.
// Source: core-kotlin-coroutine/src/main/kotlin/com/linecorp/cse/reqshield/kotlin/coroutine/ReqShield.kt at 2e792d2.
// `@<line>` in comments is a line of that file.
//
// What E5 adds to the core encoding (DESIGN-E5 2):
// 1. Exception kind CANCEL (kotlinx.coroutines.CancellationException, an IllegalStateException): an Exception, so
//    IS_EXCEPTION covers it; `catch (e: CancellationException)` takes only CANCEL; `catch (e: ClientException)` takes
//    the kinds the module throws itself.
// 2. Every cancellation point has a parameter cx (cancellable context): a suspend trusted call, ensureActive, delay.
//    cx is true outside withContext(NonCancellable) and false inside it (kotlinx 1.8.1 Builders.common.kt:134-136).
//    With cx a point may raise CANCEL; a cancelled call has no result and creates no obligation.
// 3. A cancelled unLock may or may not have released: cancelKeeps(k, lt, t) is unknown. A4 covers only the lock
//    store's own failures (RTE), not a cancellation (ReqShieldTest.kt:927 of the coroutine module: "Cancellation must
//    release the lock before its TTL").
// 4. scope.launch(start = CoroutineStart.ATOMIC) { ... } is a spawn (the block is a task). A6 (UE6 (a)): the
//    dispatcher's dispatch does not throw, so launch does not throw. A3: a block the dispatcher accepted runs. With
//    another start (atomic false) a cancelled scope may drop the block before it starts.
// 5. The RET clauses do not apply to a call that ends with a cancellation (UE7 proposal); RET_cancel: a raised
//    CANCEL is the call's exception (UE8 proposal). The trace field `cancelled` records a raised CANCEL.
// Canonical assumptions: A1, A3, A4, A5, A6 on; A2 off (UE3), as the signed core sidecar plus UE6 (a).

domain Key {}

// A5 off: the token of a Lease the store took although the call threw. The caller never sees it.
domain LostToken {
  function lostToken(k: Key, lt: Int): Int
}

// A cancelled unLock: the obligation stays when the cancellation came before the release took effect (unknown).
domain CancelledRelease {
  function cancelKeeps(k: Key, lt: Int, t: Int): Bool
}

define NULL (-1)  // null of Token?

// LockType (com.linecorp.cse.reqshield.kotlin.coroutine.LockType)
define CREATE 0
define UPDATE 1

// Mode (com.linecorp.cse.reqshield.kotlin.coroutine.config.ReqShieldWorkMode)
define CREATE_AND_UPDATE_CACHE 0
define ONLY_CREATE_CACHE 1
define ONLY_UPDATE_CACHE 2

// Exception kinds (DESIGN-E 3.5); NONE = no exception
define NONE 0
define ClientException_GET_CACHE_ERROR 1
define ClientException_SET_CACHE_ERROR 2
define ClientException_SUPPLIER_ERROR 3
define REE 4
define RTE 5
define CHK 6
define INTR 7
define CANCEL 8
define ERR 9
define IS_EXCEPTION(e) (ClientException_GET_CACHE_ERROR <= e && e <= CANCEL)  // catch (e: Exception)

// Event outcomes in the trace record
define HIT 1
define MISS 2
define THREW 3
define OK 1

// ---- Assumptions of the trusted models (DESIGN-E 4); 'assume' lines of the sidecar ----
define ERRORS_ARE_FATAL true  // A1 assumed
define LOCK_CALLS_THROW true  // A2 not assumed
define ACCEPTED_TASKS_RUN true  // A3 assumed
define THROWING_UNLOCK_RELEASES true  // A4 assumed
define THROWING_TRYLOCK_TAKES_NOTHING true  // A5 assumed
define DISPATCH_NEVER_THROWS true  // A6 assumed
define MAY_ERR (!ERRORS_ARE_FATAL)

// ---- Obligation (DESIGN-E 3.1) ----
predicate Lease(k: Key, lt: Int, t: Int)
define NO_LEASES [true, forperm qk: Key, qlt: Int, qt: Int [Lease(qk, qlt, qt)] :: false]  // LD_noleak: the thread holds no obligation
define HOLDS(k, lt) (!(forperm qk: Key, qlt: Int, qt: Int [Lease(qk, qlt, qt)] :: !(qk == k && qlt == lt)))

// LD_write: before each call of setCacheFunction (sidecar guard)
define GUARD_LD_write(k, phase, mode) ((phase == CREATE && mode != ONLY_UPDATE_CACHE ==> HOLDS(k, CREATE)) && (phase == UPDATE && mode != ONLY_CREATE_CACHE ==> HOLDS(k, UPDATE)))
// LD_supplier: before each call of callable (sidecar guard)
define GUARD_LD_supplier(k, phase, mode, gaveUp) ((phase == CREATE && mode != ONLY_UPDATE_CACHE ==> HOLDS(k, CREATE) || gaveUp) && (phase == UPDATE && mode != ONLY_CREATE_CACHE ==> HOLDS(k, UPDATE)))

// ---- Data (sidecar: class Data) ----
field value: Int

// ---- Trace record (DESIGN-E 3.2): one per thread run ----
field first: Int
field firstObj: Ref
field recheck: Int
field recheckObj: Ref
field pollHit: Bool
field pollObj: Ref
field npoll: Int
field consec: Int
field sup: Int
field supVal: Int
field nsup: Int
field ntryC: Int
field ntryU: Int
field nspawn: Int
field cancelled: Bool

define TR(tr) (acc(tr.first) && acc(tr.firstObj) && acc(tr.recheck) && acc(tr.recheckObj) && acc(tr.pollHit) && acc(tr.pollObj) && acc(tr.npoll) && acc(tr.consec) && acc(tr.sup) && acc(tr.supVal) && acc(tr.nsup) && acc(tr.ntryC) && acc(tr.ntryU) && acc(tr.nspawn) && acc(tr.cancelled))

define TR_NEW(tr) {
  tr := new(*)
  tr.first := 0
  tr.firstObj := null
  tr.recheck := 0
  tr.recheckObj := null
  tr.pollHit := false
  tr.pollObj := null
  tr.npoll := 0
  tr.consec := 0
  tr.sup := 0
  tr.supVal := 0
  tr.nsup := 0
  tr.ntryC := 0
  tr.ntryU := 0
  tr.nspawn := 0
  tr.cancelled := false
}

define PHASE(tr) (tr.first == HIT ? UPDATE : CREATE)
define GAVE_UP(tr, maxAttempt) (tr.npoll >= maxAttempt || tr.consec >= 3)

// Event rules (DESIGN-E 3.2): after each call of a trusted model, the first group whose condition holds
define EV_getCacheFunction(tr, k, e, d) {
  if (tr.first == 0) {
    tr.first := ((e) != NONE ? THREW : ((d) != null ? HIT : MISS))
    tr.firstObj := d
  } elseif (HOLDS(k, CREATE)) {
    tr.recheck := ((e) != NONE ? THREW : ((d) != null ? HIT : MISS))
    tr.recheckObj := d
  } else {
    tr.npoll := tr.npoll + 1
    if ((e) == NONE) {
      tr.consec := 0
      if ((d) != null) {
        tr.pollHit := true
        tr.pollObj := d
      }
    } else {
      tr.consec := tr.consec + 1
    }
  }
}
define EV_KeyLock_tryLock(tr, lt) {
  if (lt == CREATE) {
    tr.ntryC := tr.ntryC + 1
  } else {
    tr.ntryU := tr.ntryU + 1
  }
}
define EV_callable(tr, e, v) {
  tr.nsup := tr.nsup + 1
  tr.sup := ((e) == NONE ? OK : THREW)
  tr.supVal := v
}
// `cancelled = raised CANCEL` (E5): after each call of an entry that may raise CANCEL
define EV_raised_CANCEL(tr, e) {
  if ((e) == CANCEL) {
    tr.cancelled := true
  }
}

method KeyLock_tryLock(k: Key, lt: Int, cx: Bool) returns (exc: Int, t: Int)
  ensures exc == NONE || (LOCK_CALLS_THROW && exc == RTE) || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)
  ensures exc != NONE ==> t == NULL
  ensures t != NULL ==> Lease(k, lt, t)
  ensures exc != NONE && !THROWING_TRYLOCK_TAKES_NOTHING ==> Lease(k, lt, lostToken(k, lt))  // A5

method KeyLock_unLock(k: Key, lt: Int, t: Int, cx: Bool) returns (exc: Int, released: Bool)
  requires t != NULL && Lease(k, lt, t)  // LD_own: only the holder releases
  ensures exc == NONE || (LOCK_CALLS_THROW && exc == RTE) || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)
  ensures exc != NONE && exc != CANCEL && !THROWING_UNLOCK_RELEASES ==> Lease(k, lt, t)  // A4
  ensures exc == CANCEL && cancelKeeps(k, lt, t) ==> Lease(k, lt, t)  // a cancelled release may not have run

method getCacheFunction(k: Key, cx: Bool) returns (exc: Int, d: Ref)
  ensures exc == NONE || exc == RTE || exc == CHK || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)
  ensures exc != NONE ==> d == null

method setCacheFunction(k: Key, d: Ref, cx: Bool) returns (exc: Int, b: Bool)
  ensures exc == NONE || exc == RTE || exc == CHK || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)

method callable(cx: Bool) returns (exc: Int, v: Int)
  ensures exc == NONE || exc == RTE || exc == CHK || exc == INTR || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)

// scope.launch(start) { block } (kotlinx 1.8.1 Builders.common.kt:43-54, CoroutineStart.kt:47-55, 86-92): ATOMIC starts
// the block even in a cancelled scope; dispatch may throw only without A6. A3: an accepted block runs.
method kotlinx_launch(atomic: Bool) returns (exc: Int, dropped: Bool)
  ensures exc == NONE || (!DISPATCH_NEVER_THROWS && (exc == REE || exc == RTE)) || (MAY_ERR && exc == ERR)  // A6
  ensures dropped ==> exc == NONE && (!atomic || !ACCEPTED_TASKS_RUN)  // A3

// currentCoroutineContext().ensureActive() (Job.kt:575-577, 593-595): CANCEL if the job is cancelled.
method kotlinx_ensureActive(cx: Bool) returns (exc: Int)
  ensures exc == NONE || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)

// delay(ms) (Delay.kt:105-129): cancellable, with a prompt cancellation guarantee.
method kotlinx_delay(cx: Bool) returns (exc: Int)
  ensures exc == NONE || (cx && exc == CANCEL) || (MAY_ERR && exc == ERR)

method decideToUpdateCache() returns (b: Bool)

