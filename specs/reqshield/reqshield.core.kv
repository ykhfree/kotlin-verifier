// DRAFT sidecar for req-shield core ReqShield (DESIGN-E 6.2): the L3 client protocol, lock discipline over one call.
// Format: kv-sidecar/0 with the E additions (DESIGN-E 6.2). `source` paths are relative to the req-shield checkout.
//
// DRAFT: no clause, assumption or trusted declaration carries a `reviewed` note. The user signs them later
// (DESIGN-E 2.5: 12 intent clauses, 4 assumptions, 6 trusted declarations, 1 vocabulary approval). Until then the
// tool reads this file only with --draft (kv resolve --draft, kv lower --draft).
// Quoted sources are blocks of `kv spec snapshot` over README.md, CLAUDE.md and the KDoc of ReqShield.kt,
// ReqShieldConfiguration.kt, KeyLock.kt and ClientException.kt. A `//` comment of ReqShield.kt is no snapshot block,
// so a source that is such a comment is a `source none` line that names its line.
review intent

module com.linecorp.cse.reqshield.ReqShield client
source "core/src/main/kotlin"

// ---- Types ----
type Key   = opaque                                       // the cache key the call gets
type Token = opaque                                       // a lock's ownership token (KeyLock.kt:22-24)
enum LockType = LockType                                  // CREATE, UPDATE
enum Mode = ReqShieldWorkMode                             // CREATE_AND_UPDATE_CACHE, ONLY_CREATE_CACHE, ONLY_UPDATE_CACHE
class Data = ReqShieldData { value: Int = value }         // the cached object; `value` is the supplier's value

// ---- Vocabulary (layer 3): the obligation and the trace record (DESIGN-E 3.1, 3.2) ----
obligation Lease(Key, LockType, Token)                    // one successful acquisition: key, lock type, token

trace {
  first   = first getCacheFunction                                          // outcome and object of the first read
  recheck = getCacheFunction while holds(Lease(k, CREATE, _))                // a read under the CREATE lease
  npoll   = count getCacheFunction where !first && !holds(Lease(k, CREATE, _))
  poll    = last getCacheFunction where !first && !holds(Lease(k, CREATE, _))
  consec  = trailing failures of npoll
  nsup    = count Callable.call
  sup     = last Callable.call
  ntryC   = count KeyLock.tryLock where lockType == CREATE
  ntryU   = count KeyLock.tryLock where lockType == UPDATE
  nspawn  = count CompletableFuture.runAsync
}

// ---- Trust (layer 2): the KeyLock contract and the user functions (DESIGN-E 3.3) ----
// The exception kinds are those of spike/protocol2/target.vpr: a KeyLock call throws a RuntimeException (UE3).
trusted fun KeyLock.tryLock(key: Key, lockType: LockType) returns t: Token? creates Lease(key, lockType, t) if t != null throws RTE
trusted fun KeyLock.unLock(key: Key, lockType: LockType, token: Token) returns released: Bool consumes Lease(key, lockType, token) throws RTE
trusted value ReqShieldConfiguration.getCacheFunction(key: Key) returns d: Data? throws RTE, CHK
trusted value ReqShieldConfiguration.setCacheFunction(key: Key, data: Data, kotlin.Long) returns ok: Bool throws RTE, CHK
trusted fun java.util.concurrent.Callable.call() returns v: Int throws RTE, CHK, INTR
trusted fun com.linecorp.cse.reqshield.support.utils.decideToUpdateCache(kotlin.Long, kotlin.Long, kotlin.Int) returns update: Bool

use jdk.CompletableFuture.runAsync
use jdk.CompletableFuture.whenComplete
use jdk.Thread.sleep
use jdk.Thread.interrupt
use kotlin.runCatching
use slf4j.Logger

// ---- Assumptions of the trusted models (DESIGN-E 4); A2 is off (UE3) ----
assume A1: errors-are-fatal
  source none "user decision UE2 (2026-10-26): a java.lang.Error ends the process, so no call throws one"
assume A3: accepted-tasks-run
  source "ReqShieldConfiguration.kt#decl49" quote "the library never shuts the pool down - a caller-supplied one stays the"
  source none "user decision UE4 (2026-10-26): a task the executor accepted runs"
assume A4: throwing-release-ends-obligation
  source none "ReqShield.kt:150, a code comment: A failed release must not cost the caller its data; the lock then expires on its own"
assume A5: throwing-acquire-takes-nothing
  source "ReqShieldConfiguration.kt#decl35" quote "must let the lock expire"

// ---- The public function: one thread's run (DESIGN-E 6.1) ----
operation getAndSet = fun ReqShield.getAndSetReqShieldData {
  free mode = this.reqShieldConfig.reqShieldWorkMode
  free maxAttempt = this.reqShieldConfig.maxAttemptGetCache
  result res
  // LD_write: a cache write of a collapsing path holds that path's lock (UE5 open: the fallback after the wait).
  guard LD_write: setCacheFunction requires
      (PHASE == CREATE && mode != ONLY_UPDATE_CACHE ==> holds(Lease(k, CREATE, _))) &&
      (PHASE == UPDATE && mode != ONLY_CREATE_CACHE ==> holds(Lease(k, UPDATE, _)))
    source "CLAUDE.md#work-modes/2" quote "refreshes of existing entries still happen but without a lock"
    source "CLAUDE.md#work-modes/3" quote "on a cache miss every request calls the supplier and writes the cache without a lock"
    source none "UE5 open (DESIGN-E 2.3): this shape says the fallback after the wait does not write the cache"
  // LD_supplier: so does a supplier call, except the creation fallback after the wait gave up.
  guard LD_supplier: Callable.call requires
      (PHASE == CREATE && mode != ONLY_UPDATE_CACHE ==> holds(Lease(k, CREATE, _)) || GAVE_UP) &&
      (PHASE == UPDATE && mode != ONLY_CREATE_CACHE ==> holds(Lease(k, UPDATE, _)))
    source "ReqShield.kt#handleLockFailure" quote "The supplier is never called from the polling loop - it is called on this"
    source "CLAUDE.md#project-overview/1" quote "ensuring only one request for the same cache key is processed at a time"
  ensures MODE_create: mode == ONLY_UPDATE_CACHE ==> ntryC == 0
    source "CLAUDE.md#work-modes/3" quote "on a cache miss every request calls the supplier and writes the cache without a lock"
    source none "ReqShield.kt:88, a code comment: ONLY_UPDATE_CACHE collapses requests on cache update only, so the creation runs without a lock"
  ensures MODE_update: mode == ONLY_CREATE_CACHE ==> ntryU == 0
    source "CLAUDE.md#work-modes/2" quote "refreshes of existing entries still happen but without a lock"
    source none "ReqShield.kt:65, a code comment: ONLY_CREATE_CACHE collapses requests on cache creation only, so the update runs without a lock"
  ensures SUP_once: nsup <= 1
    source "ReqShield.kt#handleLockFailure" quote "so at most one extra supplier call per waiting request"
    source "README.md#waiting-for-another-request-lock-not-acquired/3" quote "When the attempts are exhausted the request calls the supplier once."
  ensures POLL_bound: npoll <= (maxAttempt < 0 ? 0 : maxAttempt)
    source "ReqShield.kt#handleLockFailure" quote "The wait ends after [ReqShieldConfiguration.maxAttemptGetCache] polls, or earlier when"
    source "README.md#waiting-for-another-request-lock-not-acquired/1" quote "up to `maxAttemptGetCache` times (default 60)."
  ensures RET_hit: first == HIT ==> exc == NONE && res == first.obj
    source "ReqShield.kt#runInBackground" quote "Only that background cache write or refresh is dropped: the caller still gets its data."
    source "ReqShieldConfiguration.kt#decl49" quote "the request still gets its data and the lock is released."
    source none "user decision UE3 (2026-10-26): the caller does not lose a result it already has"
  ensures RET_get_error: first == THREW ==> exc == CE_GET
    source "ClientException.kt#ClientException" quote "Wraps failures raised by client-provided functions (supplier, cache getter/setter, lock functions)."
  ensures RET_recheck: recheck == HIT ==> exc == NONE && res == recheck.obj && nsup == 0 && nspawn == 0
    source none "ReqShield.kt:94, a code comment: Another request may have filled the cache between our initial miss and lock acquisition."
    source none "user decision UE3 (2026-10-26): the caller does not lose a result it already has"
  ensures RET_poll: poll == HIT ==> exc == NONE && res == poll.obj && nsup == 0
    source "ReqShield.kt#handleLockFailure" quote "Another request holds the lock: poll the cache until that request publishes its result."
    source "README.md#waiting-for-another-request-lock-not-acquired/1" quote "A request that loses the lock polls the cache every 50 ms"
  ensures RET_supplier: sup == OK ==> exc == NONE && res != null && res.value == sup.value
    source "ReqShield.kt#runInBackground" quote "Only that background cache write or refresh is dropped: the caller still gets its data."
    source "ReqShieldConfiguration.kt#decl49" quote "the request still gets its data and the lock is released."
  ensures RET_supplier_error: sup == THREW ==> exc == CE_SUP
    source "README.md#waiting-for-another-request-lock-not-acquired/3" quote "A supplier failure is propagated as a"
    source none "user decision UE3 (2026-10-26): the caller does not lose a result it already has"
}

// ---- Hole (layer 5): the invariant of the polling loop, the code's counters against the trace (DESIGN-E 6.8) ----
// The five conjuncts of spike/protocol2/target.vpr 504-508, in its names; E3 fixes the vocabulary a loop hole uses.
hole loop ReqShield.handleLockFailure@181 """
  0 <= attempts__178 && (maxAttempt < 0 ? attempts__178 == 0 : attempts__178 <= maxAttempt) &&
  tr.npoll <= attempts__178 && (exc == NONE ==> tr.npoll == attempts__178) &&
  (exc == NONE && found_187 == null ==> tr.consec == consecutiveFailures__179) &&
  (break_192 ==> consecutiveFailures__179 >= MAX_FAIL) && (!break_192 ==> consecutiveFailures__179 < MAX_FAIL) &&
  (found_187 != null) == tr.pollHit && (found_187 != null ==> tr.pollObj == found_187 && exc == NONE)
"""
