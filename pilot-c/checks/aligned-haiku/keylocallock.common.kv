// Skeleton of the KeyLocalLock specification. Format: kv-sidecar/0.
// The binding part below (types, state, class, use, trusted fun, ghost record, witness, the free/result lines of
// each operation) is fixed: the team's tooling derives it from the shape every implementation must follow.
// Do not change, remove or reorder the fixed lines. Add your clauses only where a line says "DRAFT".

// ---- Abstract types for String values ----
type Key   = opaque                     // lock keys: one per (cache key, lock type)
type Token = template "local-${Long}"   // a token "local-" + n is the number n >= 0; null is NULL

// ---- Module state (one map shared by the whole JVM) ----
state m:   Map<Key, LockInfo> = lockMap

// ---- Classes reachable from the state ----
class LockInfo = KeyLocalLock.LockInfo {
  permits:   Semaphore     = semaphore   // free permits of the entry's semaphore (an Int)
  isHeld:    AtomicBoolean = isHeld      // the entry's held flag (a Bool)
  token:     Token?        = token       // the token the entry carries, or NULL
  expiresAt: Long          = expiresAt   // the entry's expiry time in epoch milliseconds (an Int)
}

// ---- Trusted models (built into the tool) ----
use jdk.ConcurrentHashMap.compute
use jdk.ConcurrentHashMap.mappingCount
use jdk.ConcurrentHashMap.racyRead
use jdk.Semaphore
use jdk.AtomicBoolean
use jdk.AtomicLong
use jdk.AtomicCell
use jdk.System.currentTimeMillis
use slf4j.Logger

// ---- Trusted project functions (bodies read by a person) ----
trusted fun com.linecorp.cse.reqshield.support.utils.nowToEpochTime() = clock
  reviewed "ykhfree 2026-10-23: support/.../utils/TimeUtils.kt:23: fun nowToEpochTime() = System.currentTimeMillis()" sha256 "aa569e5b9740b13b"
trusted fun com.linecorp.cse.reqshield.support.config.LocalLockLimit.rejectsNewEntry(kotlin.Long)
  returns rej: Bool
  ghost   limit: Int                    // the cap the call read
  ensures rej ==> limit != 0
  effects none                          // rejectionCount and logging are outside the model
  reviewed "ykhfree 2026-10-23: support/.../config/LocalLockLimit.kt:86-101: returns false when limit == UNLIMITED_LOCK_ENTRIES (0L) or currentSize < limit" sha256 "c5bffa07e14e90b1"

// ---- Ghost state: one record per token value ----
ghost record tok(Token) {
  gIssued: Bool set-once                // tryLock returned this token (the tool sets it)
  gKey:    Key  frozen                  // the key the token was issued for (the issue rule sets it)
  gBacked: Bool frozen                  // a map entry carried the token when it was issued (the issue rule sets it)
  gHeld:   Bool ends                    // the acquisition has not ended (the tool sets and ends it)
  gLease:  Int  frozen                  // the time the acquisition expires (the issue rule sets it)
}
witness LockInfo.token                  // a backed token is held while its key's entry carries it

// ---- Operations: exactly one atomic action each ----
operation tryLock = fun KeyLocalLock.tryLock {
  free now        = local now           // the clock reading tryLock takes before its atomic step
  free timeout    = this.lockTimeoutMillis
  free rej, limit = call rejectsNewEntry
  result res
  // source: [KeyLock.kt(core)#tryLock] "Acquires the lock for [key] + [lockType]."
  // source: [README.md#local-lock-map-size/4] "a request for a **new** key is handed a permit that no map entry backs"
  // source: [README.md#local-lock-map-size/2] "cleanup monitor once `lockTimeoutMillis` has passed, which runs on a 1 s interval and so can lag by up to that much."
  // source: none (gBacked and gLease follow the issue rule; gLease is the expiry, see QUESTIONS Q2)
  issue res { gKey = k; gBacked = carried(S, k, res); gLease = now + timeout }
  reviewed "PILOT, not signed by the user" sha256 "023e62e52c1fc231"

  // source: [KeyLock.kt(core)#tryLock] "or null when another holder owns the lock."
  // source: [README.md#local-lock-map-size/4] "a request for a **new** key is handed a permit that no map entry backs"
  ensures progress_new_key: !old(has(S, k)) ==> res != NULL

  // source: [KeyLock.kt(core)#KeyLock] "a holder whose lock already expired and was taken over by someone else"
  // source: [README.md#local-lock-map-size/4] "Keys whose entry is already in"
  ensures progress_expired_takeover: old(has(S, k)) && old(S.m[k].expiresAt) < now ==> res != NULL

  // source: [KeyLock.kt(core)#tryLock] "or null when another holder owns the lock."
  // source: none (an owner is an entry whose expiry is after now, see QUESTIONS Q1 and Q3)
  ensures tryLock_null_when_owned: old(has(S, k)) && old(S.m[k].expiresAt) >= now ==> res == NULL

  // source: [KeyLock.kt(core)#tryLock] "or null when another holder owns the lock."
  // source: none (an owner is an entry whose expiry is after now, see QUESTIONS Q1 and Q3)
  ensures tryLock_null_only_when_owned: res == NULL ==> (old(has(S, k)) && old(S.m[k].expiresAt) >= now)

  // source: [KeyLock.kt(core)#tryLock] "or null when another holder owns the lock."
  // source: none (a refused tryLock does not renew the lease, see QUESTIONS Q16)
  ensures tryLock_null_keeps_owner: res == NULL ==> (old(has(S, k)) && has(S, k) && S.m[k].token == old(S.m[k].token) && S.m[k].expiresAt == old(S.m[k].expiresAt))

  // source: [KeyLock.kt(core)#KeyLock] "Ownership is represented by an opaque token:"
  // source: [README.md#local-lock-map-size/4] "a request for a **new** key is handed a permit that no map entry backs"
  ensures grant_carried: res != NULL && !(rej && !old(has(S, k))) ==> carried(S, k, res)

  // source: [README.md#local-lock-map-size/2] "cleanup monitor once `lockTimeoutMillis` has passed, which runs on a 1 s interval and so can lag by up to that much."
  // source: none (lockTimeoutMillis is a lease counted from the grant, see QUESTIONS Q2 and Q13)
  ensures grant_lease: res != NULL && carried(S, k, res) ==> S.m[k].expiresAt == now + timeout

  // source: [README.md#local-lock-map-size/4] "a request for a **new** key is handed a permit that no map entry backs"
  ensures capped_new_key_not_inserted: rej && !old(has(S, k)) ==> !has(S, k)

  // source: [README.md#local-lock-map-size/4] "a request for a **new** key is handed a permit that no map entry backs"
  unbacked_only_if ub_capped_new_key: rej && !old(has(S, k))
  reviewed "PILOT, not signed by the user" sha256 "6eac01fcb3a85f18"

  // source: [KeyLock.kt(core)#KeyLock] "a holder whose lock already expired and was taken over by someone else"
  // source: none (the taken-over token ends at takeover, see QUESTIONS Q1)
  ends_only_if tryLock_takeover: old(carried(S, k, qt)) && old(S.m[k].expiresAt) < now
  reviewed "PILOT, not signed by the user" sha256 "427be03b538b278b"
}

operation unLock = fun KeyLocalLock.unLock {
  free t: Token = param token
  result res
  // source: [KeyLock.kt(core)#unLock] "Releases the lock for [key] + [lockType] only if [token] matches the current owner."
  // source: [KeyLock.kt(core)#unLock] "@return false when the lock is not held or the token does not match the current owner."
  ensures unLock_result: res == old(carried(S, k, t))

  // source: [README.md#local-lock-map-size/2] "An entry is dropped as soon as the lock is released"
  ensures unLock_release_removes: res ==> !has(S, k)

  // source: [CLAUDE.md#key-components/2] "`unLock` only releases when the token matches, so a slow holder cannot release someone else's lock"
  ensures unLock_refused_keeps_entry: !res ==> (has(S, k) == old(has(S, k)))

  // source: [KeyLock.kt(core)#KeyLock] "cannot release the new owner's lock."
  ensures unLock_refused_keeps_owner: !res && old(has(S, k)) ==> (has(S, k) && S.m[k].token == old(S.m[k].token))

  // source: [KeyLock.kt(core)#unLock] "Releases the lock for [key] + [lockType] only if [token] matches the current owner."
  ends_only_if unLock_release: qt == t && old(carried(S, k, qt))
  reviewed "PILOT, not signed by the user" sha256 "4b3c5e3dea791e1a"
}

operation sweep = compute in KeyLocalLock.Companion {
  free now = local now                  // the clock reading of one monitor pass
  // source: [README.md#local-lock-map-size/2] "cleanup monitor once `lockTimeoutMillis` has passed"
  ensures sweep_only_drops: !old(has(S, k)) ==> !has(S, k)

  // source: [README.md#local-lock-map-size/2] "cleanup monitor once `lockTimeoutMillis` has passed"
  ensures sweep_keeps_live: old(has(S, k)) && old(S.m[k].expiresAt) >= now ==> (has(S, k) && S.m[k].token == old(S.m[k].token))

  // source: [README.md#local-lock-map-size/2] "cleanup monitor once `lockTimeoutMillis` has passed, which runs on a 1 s interval and so can lag by up to that much."
  // source: none (a monitor step at or after the expiry drops the entry, see QUESTIONS Q3 and Q5)
  ensures progress_sweep_drops_expired: old(has(S, k)) && old(S.m[k].expiresAt) < now ==> !has(S, k)

  // source: [README.md#local-lock-map-size/2] "cleanup monitor once `lockTimeoutMillis` has passed"
  ends_only_if sweep_drops_expired: old(carried(S, k, qt)) && old(S.m[k].expiresAt) < now
  reviewed "PILOT, not signed by the user" sha256 "514b36a61e6cc114"
}

// source: none (ghost rule 2 in LANGUAGE.md section 3 ends an acquisition when its entry stops carrying the token)
invariant held_backed_carried: forall x: Int :: { tok(x).gHeld } x >= 0 && tok(x).gIssued && tok(x).gBacked && tok(x).gHeld ==> carried(S, tok(x).gKey, x)

// source: [CLAUDE.md#project-overview/1] "ensuring only one request for the same cache key is processed at a time"
// source: [README.md#local-lock-map-size/4] "so what the cap costs is request collapsing"
lemma backed_exclusive: forall x: Int, y: Int :: { tok(x).gHeld, tok(y).gHeld } x >= 0 && y >= 0 && tok(x).gIssued && tok(y).gIssued && tok(x).gBacked && tok(y).gBacked && tok(x).gHeld && tok(y).gHeld && tok(x).gKey == tok(y).gKey ==> x == y

// ---- Inductive invariant: filled per implementation by a separate tool step. Do not edit. ----
hole MI_INV """
  // INV-E: every entry is held, has no free permit, and carries a token.
  (forall qk: Key :: { S.m[qk] } has(S, qk) ==>
     S.m[qk].permits == 0 && S.m[qk].isHeld && S.m[qk].token != NULL) &&
  // The counter is never negative, and every issued token is between 0 and the counter.
  0 <= S.seq &&
  (forall qt: Int :: { tok(qt).gIssued } tok(qt).gIssued ==> 0 <= qt && qt <= S.seq) &&
  // Each entry's token is a held backed token issued for this key, with the entry's lease.
  (forall qk: Key :: { S.m[qk] } has(S, qk) ==>
     tok(S.m[qk].token).gIssued && tok(S.m[qk].token).gKey == qk &&
     tok(S.m[qk].token).gBacked && tok(S.m[qk].token).gHeld &&
     tok(S.m[qk].token).gLease == S.m[qk].expiresAt) &&
  // Each held backed token is the token of its key's entry.
  (forall qt: Int :: { tok(qt).gHeld }
     tok(qt).gIssued && tok(qt).gBacked && tok(qt).gHeld ==>
       has(S, tok(qt).gKey) && S.m[tok(qt).gKey].token == qt)
"""

// source: none (probe shows the clauses are not vacuous; key replaces the reserved name k, see LANGUAGE.md section 5)
probe(key: Key, a: Int) requires a >= 0 {
  x := tryLock(key, now = a, timeout = 3000, rej = false, limit = 0)
  y := tryLock(key, now = a + 1, timeout = 3000, rej = false, limit = 0)
  assert y == NULL
  ok := unLock(key, t = x)
  assert ok
}
